{
  "redirects": [
    {
      "source": "/admin/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
