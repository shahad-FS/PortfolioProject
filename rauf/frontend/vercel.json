{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://portfolioproject-bdyu.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/static/:path*"
    },
    {
      "source": "/verify-email/:token",
      "destination": "/index.html"
    },
    {
      "source": "/((?!admin|api|static).*)",
      "destination": "/index.html"
    }
  ]
}
