{
  "redirects": [
    {
      "source": "/admin/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/admin/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portfolioproject-bdyu.onrender.com/api/:path*"
    },
    {
      "source": "/verify-email/:token",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
